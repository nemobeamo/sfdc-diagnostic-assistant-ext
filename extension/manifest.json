{
  "manifest_version": 3,
  "name": "Salesforce Support Diagnostic Assistant (Prototype)",
  "version": "0.6.2",
  "description": "Record a Salesforce reproduction and export local diagnostic evidence.",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "tabCapture",
    "debugger",
    "offscreen",
    "storage",
    "alarms",
    "identity",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Salesforce diagnostics",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
